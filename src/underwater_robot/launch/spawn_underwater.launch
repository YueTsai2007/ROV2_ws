<?xml version="1.0"?>
<launch>
  <!-- Set environment variables -->
  <env name="SVGA_VGPU10" value="0" />
  
  <!-- Launch GazeboWorld -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="true"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Usestdinway to spawn underwater robot -->
  <node name="spawn_underwater" pkg="gazebo_ros" type="spawn_model" 
        args="-stdin -urdf -model underwater_robot -x 0 -y 0 -z -5" 
        output="screen">
    <param name="robot_description" command="cat $(find underwater_robot)/urdf/underwater_robot.urdf" />
  </node>
  
</launch>s

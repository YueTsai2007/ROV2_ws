<?xml version="1.0"?>
<launch>
  <!-- Set environment variables -->
  <env name="SVGA_VGPU10" value="0" />
  <env name="PYTHONIOENCODING" value="utf-8" />
  
  <!-- Start uuv_simulator underwater world -->
  <include file="$(find uuv_gazebo_worlds)/launch/empty_underwater_world.launch">
    <arg name="gui" value="false"/>
    <arg name="paused" value="false"/>
  </include>

  <!-- Load complete underwater robot description -->
  <param name="robot_description" textfile="$(find underwater_robot)/urdf/underwater_robot_complete.urdf" />
  
  <!-- Spawn underwater robot -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-param robot_description -urdf -model final_underwater_robot -x 0 -y 0 -z -5" />
  
  <!-- Launch robot state publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  
  <!-- Launch joint state publisher -->
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
  
</launch>

<launch>
  <!-- Start only after model, odometry and actuators have been tested. -->
  <arg name="uuv_name" default="underwater_robot"/>
  <arg name="saturation" default="100"/>
  <arg name="gui_on" default="false"/>
  <arg name="Kp" default="20,20,20,10,10,10"/>
  <arg name="Kd" default="10,10,10,5,5,5"/>
  <arg name="Ki" default="0,0,0,0,0,0"/>
  <include file="$(find uuv_trajectory_control)/launch/rov_pid_controller.launch">
    <arg name="uuv_name" value="$(arg uuv_name)"/>
    <arg name="model_name" value="$(arg uuv_name)"/>
    <arg name="saturation" value="$(arg saturation)"/>
    <arg name="gui_on" value="$(arg gui_on)"/>
    <arg name="use_ned_frame" value="false"/>
    <arg name="Kp" value="$(arg Kp)"/><arg name="Kd" value="$(arg Kd)"/><arg name="Ki" value="$(arg Ki)"/>
    <arg name="thruster_manager_config_file" value="$(find underwater_robot)/config/thruster_manager.yaml"/>
    <arg name="tam_file" value="$(find underwater_robot)/config/TAM.yaml"/>
  </include>
  <node if="$(arg gui_on)" name="rviz" pkg="rviz" type="rviz" args="-d $(find underwater_robot)/config/standard_ros.rviz"/>
</launch>

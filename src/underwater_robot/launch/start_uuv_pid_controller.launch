<?xml version="1.0"?>
<launch>
    <arg name="uuv_name" default="underwater_robot"/>
    <arg name="saturation" default="500"/>
    <arg name="gui_on" default="true"/>
    <arg name="use_ned_frame" default="false"/>
    
    <!-- Add missingParametersDefine -->
    <arg name="teleop_on" default="true"/>
    <arg name="joy_id" default="0"/>
    <arg name="axis_yaw" default="0"/>
    <arg name="axis_x" default="4"/>
    <arg name="axis_y" default="3"/>
    <arg name="axis_z" default="1"/>
    
    <!-- PIDParameters -->
    <arg name="Kp" default="5000,5000,5000,8000,8000,8000"/>
    <arg name="Kd" default="3000,3000,3000,5000,5000,5000"/>
    <arg name="Ki" default="100,100,100,500,500,500"/>

    <!-- Key: use your own robot config -->
    <arg name="thruster_manager_output_dir" default="$(find underwater_robot)/config"/>
    <arg name="thruster_manager_config_file" default="$(find underwater_robot)/config/thruster_manager.yaml"/>
    <arg name="tam_file" default="$(find underwater_robot)/config/TAM.yaml"/>

    <!-- Key: add robotURDF模型Load - UsexacroFile -->
    <param name="robot_description"
           command="$(find xacro)/xacro --inorder '$(find underwater_robot)/urdf/underwater_robot_uuv2.xacro'"/>

   
    <!-- Publish default joint states (all joint angles at0） -->
<node name="simple_joint_publisher" pkg="underwater_robot" type="publish_default_joint_states.py" 
      output="screen" if="$(arg gui_on)"
      launch-prefix="bash -c 'sleep 5; $0 $@' "/>
    <!-- Publish robot state -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"
          respawn="true" output="screen">
        <param name="publish_frequency" type="double" value="50.0" />
        <remap from="joint_states" to="/underwater_robot/joint_states" />
    </node>

    

    <include file="$(find uuv_trajectory_control)/launch/rov_pid_controller.launch">
      <arg name="uuv_name" value="$(arg uuv_name)"/>
      <arg name="model_name" value="%(arg uuv_name)"/>
      <arg name="saturation" value="$(arg saturation)"/>
      <arg name="gui_on" value="$(arg gui_on)"/>
      <arg name="use_ned_frame" value="$(arg use_ned_frame)"/>
      <arg name="Kp" value="$(arg Kp)"/>
      <arg name="Kd" value="$(arg Kd)"/>
      <arg name="Ki" value="$(arg Ki)"/>
      <arg name="thruster_manager_output_dir" value="$(arg thruster_manager_output_dir)"/>
      <arg name="thruster_manager_config_file" value="$(arg thruster_manager_config_file)"/>
      <arg name="tam_file" value="$(arg tam_file)"/>

    </include>



    <!-- Launch RVizMonitor -->
    <group if="$(arg gui_on)">
      <node name="rviz" pkg="rviz" type="rviz" output="screen" 
            args="-d $(find underwater_robot)/rviz/underwater_robot_control.rviz"/>
    </group>
</launch>

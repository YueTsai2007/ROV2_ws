<?xml version="1.0"?>
<launch>
  <!-- Set environment variablesAvoid graphics issues -->
  <env name="SVGA_VGPU10" value="0" />
  <env name="LIBGL_ALWAYS_SOFTWARE" value="1" />
  
  <!-- UseGazebofully headless mode -->
  <node name="gazebo" pkg="gazebo_ros" type="gzserver" 
        args="$(find uuv_gazebo_worlds)/worlds/empty_underwater.world -e ode" 
        output="screen"/>
  
  <!-- Spawn underwater robot -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-file $(find underwater_robot)/urdf/underwater_robot_clean.urdf -urdf -model underwater_robot -x 0 -y 0 -z -5"
        output="screen"/>
  
</launch>

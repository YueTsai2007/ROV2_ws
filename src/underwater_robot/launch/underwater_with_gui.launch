<?xml version="1.0"?>
<launch>
  <arg name="software_gl" default="true" />

  <!-- Set graphics environment variables -->
  <env name="SVGA_VGPU10" value="0" />
  <env if="$(arg software_gl)" name="LIBGL_ALWAYS_SOFTWARE" value="1" />
  
  <!-- Start uuv_simulator underwater world（With GUI） -->
  <include file="$(find uuv_gazebo_worlds)/launch/empty_underwater_world.launch">
    <arg name="gui" value="true"/>
    <arg name="paused" value="false"/>
  </include>

  <!-- Load robot description and state publishers under /underwater_robot -->
  <group ns="underwater_robot">
    <param name="robot_description" textfile="$(find underwater_robot)/urdf/underwater_robot.urdf" />
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
      <param name="tf_prefix" value="underwater_robot" />
    </node>
  </group>
  
  <!-- Spawn underwater robot -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-param /underwater_robot/robot_description -urdf -model underwater_robot -x 0 -y 0 -z -5" />

  <!-- Publish world -> underwater_robot/base_link TF for RViz -->
  <node name="world_to_base_link" pkg="tf2_ros" type="static_transform_publisher"
        args="0 0 -5 0 0 0 world underwater_robot/base_link" />
  
  <!-- Launch RVizView simultaneously -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find underwater_robot)/config/standard_ros.rviz" />
  
</launch>

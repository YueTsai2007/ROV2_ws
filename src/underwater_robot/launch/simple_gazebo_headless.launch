<?xml version="1.0"?>
<launch>
  
  <!-- Launch basic Gazebo world（无GUI） -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="true"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Load robot description -->
  <param name="robot_description" textfile="$(find underwater_robot)/urdf/underwater_robot_simple_geometry.urdf" />
  
  <!-- Spawn robot -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-urdf -param robot_description -model underwater_robot -x 0 -y 0 -z 1" 
        output="screen"/>
  
</launch>

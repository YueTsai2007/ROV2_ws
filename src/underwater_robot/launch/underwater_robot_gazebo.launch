<?xml version="1.0"?>
<launch>
  <!-- Set environment variables -->
  <env name="SVGA_VGPU10" value="0" />
  
  <!-- Launch GazeboWorld -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="true"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Load robot description toParametersServer -->
  <param name="robot_description" textfile="$(find underwater_robot)/urdf/underwater_robot.urdf" />
  
  <!-- Spawn underwater robot -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-param robot_description -urdf -model underwater_robot -x 0 -y 0 -z -5" />
  
</launch>

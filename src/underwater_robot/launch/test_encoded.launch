<?xml version="1.0"?>
<launch>
  <!-- Set encodingEnvironment variables -->
  <env name="PYTHONIOENCODING" value="utf-8" />
  <env name="LANG" value="en_US.UTF-8" />
  <env name="LC_ALL" value="en_US.UTF-8" />
  <env name="SVGA_VGPU10" value="0" />
  
  <!-- Launch GazeboWorld -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="true"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- UsexacroLoad robot description (avoid directURDFFile） -->
  <param name="robot_description" command="$(find xacro)/xacro '$(find underwater_robot)/urdf/test_simple.xacro'" />
  
  <!-- Spawn robot -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-urdf -param robot_description -model encoded_robot -x 0 -y 0 -z 1" />
  
</launch>

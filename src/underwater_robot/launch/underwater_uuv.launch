<?xml version="1.0"?>
<launch>
  <arg name="debug" default="0"/>
  <arg name="x" default="0"/>
  <arg name="y" default="0"/>    
  <arg name="z" default="-20"/>
  <arg name="roll" default="0.0"/>
  <arg name="pitch" default="0.0"/>
  <arg name="yaw" default="0.0"/>
  <arg name="namespace" default="underwater_robot"/>
  <arg name="use_ned_frame" default="false"/>

  <!-- Use与RexROV2same way to load robot -->
  <group ns="$(arg namespace)">
    <!-- Spawn first then cleanuprobot_description -->
    <param name="robot_description"
           command="bash -c '$(find xacro)/xacro &quot;$(find underwater_robot)/urdf/underwater_robot_uuv2.xacro&quot; namespace:=$(arg namespace) debug:=$(arg debug) inertial_reference_frame:=world | tr -d &quot;\r&quot;'"/>

    <!-- Useuuv_descriptions的spawn_model -->
    <node name="urdf_spawner" pkg="uuv_descriptions" type="spawn_model" respawn="false" output="screen"
          args="-urdf -x $(arg x) -y $(arg y) -z $(arg z) -R $(arg roll) -P $(arg pitch) -Y $(arg yaw) -model $(arg namespace) -param /$(arg namespace)/robot_description"/>
    
    <!-- Publish robot model for ROS -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="true" output="screen">
      <param name="robot_description" value="/$(arg namespace)/robot_description" />
      <param name="publish_frequency" value="5" />
    </node>
  </group>

  <!-- TFConvert -->
  <include file="$(find uuv_assistants)/launch/message_to_tf.launch">
    <arg name="namespace" value="$(arg namespace)"/>
    <arg name="world_frame" value="world"/>
    <arg name="child_frame_id" value="/$(arg namespace)/base_link"/>
  </include>
</launch>

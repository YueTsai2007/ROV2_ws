<launch>
  <arg name="uuv_name" default="underwater_robot"/>
  <include file="$(find uuv_trajectory_control)/launch/rov_pid_controller.launch">
    <arg name="uuv_name" value="$(arg uuv_name)"/><arg name="model_name" value="$(arg uuv_name)"/>
    <arg name="gui_on" value="false"/><arg name="use_ned_frame" value="false"/>
    <arg name="saturation" value="30"/><arg name="Kp" value="15,15,20,2,2,3"/>
    <arg name="Kd" value="15,15,20,2,2,3"/><arg name="Ki" value="0,0,0,0,0,0"/>
    <arg name="thruster_timeout" value="0.5"/>
    <arg name="thruster_manager_config_file" value="$(find underwater_robot)/config/demo_thruster_manager.yaml"/>
    <arg name="tam_file" value="$(find underwater_robot)/config/demo_TAM.yaml"/>
  </include>
</launch>

<?xml version="1.0"?>
<launch>
  
  <!-- LaunchuuvUnderwater world -->
  <include file="$(find uuv_gazebo_worlds)/launch/empty_underwater_world.launch">
    <arg name="gui" value="true"/>
    <arg name="paused" value="false"/>
  </include>

  <!-- Load robot description -->
  <param name="robot_description" textfile="$(find underwater_robot)/urdf/underwater_robot_simple_geometry.urdf" />
  
  <!-- Spawn robot -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-urdf -param robot_description -model underwater_robot -x 0 -y 0 -z -5" 
        output="screen"/>
  
  <!-- Publish robot state -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  
</launch>

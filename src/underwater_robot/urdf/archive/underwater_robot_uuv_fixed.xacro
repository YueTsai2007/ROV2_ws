<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="underwater_robot">

  <!-- 包含 uuv_simulator 的宏定义 -->
  <xacro:include filename="$(find uuv_descriptions)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find uuv_descriptions)/urdf/gazebo.urdf.xacro"/>
  
  <!-- 参数 -->
  <xacro:arg name="namespace" default="underwater_robot"/>
  
  <!-- 包含原始URDF -->
  <xacro:include filename="$(find underwater_robot)/urdf/underwater_robot.urdf"/>

  <!-- 添加 uuv_simulator 的水动力学插件 -->
  <gazebo>
    <plugin name="$(arg namespace)_hydrodynamics" filename="libuuv_underwater_object_ros_plugin.so">
      <fluid_density>1028.0</fluid_density>
      <volume>0.1</volume>
      <bbox_height>0.5</bbox_height>
      <bbox_length>1.0</bbox_length>
      <bbox_width>0.8</bbox_width>
      <hydro_model_type>fossen</hydro_model_type>
      <added_mass>
        <x>50</x> <y>50</y> <z>50</z>
        <roll>10</roll> <pitch>10</pitch> <yaw>10</yaw>
      </added_mass>
      <linear_damping>
        <x>20</x> <y>20</y> <z>20</z>
      </linear_damping>
      <linear_damping_forward_speed>
        <x>0</x> <y>0</y> <z>0</z>
      </linear_damping_forward_speed>
      <angular_damping>
        <x>20</x> <y>20</y> <z>20</z>
      </angular_damping>
      <center_of_buoyancy>
        <x>0</x> <y>0</y> <z>0.1</z>
      </center_of_buoyancy>
      <center_of_buoyancy_damping>
        <x>0</x> <y>0</y> <z>0</z>
      </center_of_buoyancy_damping>
      <neutrally_buoyant>false</neutrally_buoyant>
      <radius>0.5</radius>
    </plugin>
  </gazebo>

  <!-- 使用 uuv_simulator 的标准推进器定义 -->
  <!-- 注意：我们需要先定义基础链接，然后添加推进器 -->
  <xacro:macro name="underwater_robot_thrusters" params="namespace">
    <!-- 前左推进器 -->
    <xacro:include filename="$(find uuv_descriptions)/urdf/thruster.xacro"/>
    <xacro:thruster_module_first_order_basic namespace="${namespace}" 
                                           thruster_name="thruster_front_left"
                                           link_name="base_link">
      <origin xyz="0.28826 0.18 -0.10969" rpy="0 0 0"/>
      <axis xyz="0.866025 0 0.5"/>
    </xacro:thruster_module_first_order_basic>

    <!-- 前右推进器 -->
    <xacro:thruster_module_first_order_basic namespace="${namespace}" 
                                           thruster_name="thruster_front_right"
                                           link_name="base_link">
      <origin xyz="0.28826 0.18 0.10969" rpy="0 0 0"/>
      <axis xyz="0.866025 0 -0.5"/>
    </xacro:thruster_module_first_order_basic>

    <!-- 后左推进器 -->
    <xacro:thruster_module_first_order_basic namespace="${namespace}" 
                                           thruster_name="thruster_back_left"
                                           link_name="base_link">
      <origin xyz="-0.28828 0.18 -0.10969" rpy="0 0 0"/>
      <axis xyz="-0.86603 0 0.5"/>
    </xacro:thruster_module_first_order_basic>

    <!-- 后右推进器 -->
    <xacro:thruster_module_first_order_basic namespace="${namespace}" 
                                           thruster_name="thruster_back_right"
                                           link_name="base_link">
      <origin xyz="-0.28828 0.18 0.10969" rpy="0 0 0"/>
      <axis xyz="-0.86603 0 -0.5"/>
    </xacro:thruster_module_first_order_basic>
  </xacro:macro>

  <!-- 调用推进器宏 -->
  <xacro:underwater_robot_thrusters namespace="$(arg namespace)"/>

</robot>

<?xml version="1.0"?>
<!-- Based on rexrov_actuators.xacro structure -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Degree to radian conversion factor -->
  <xacro:property name="d2r" value="0.017453292519943295"/>

  <xacro:macro name="underwater_robot_actuators" params="namespace">
    
    <!-- Front left thruster - based on J1 joint -->
    <xacro:thruster_macro namespace="${namespace}" thruster_id="0">
      <origin xyz="0.28826 0.18 -0.10969" rpy="0 0 0"/>
    </xacro:thruster_macro>
    
    <!-- Front right thruster - based on J2 joint -->
    <xacro:thruster_macro namespace="${namespace}" thruster_id="1">
      <origin xyz="0.28826 0.18 0.10969" rpy="0 0 0"/>
    </xacro:thruster_macro>
    
    <!-- Rear left thruster - based on J7 joint -->
    <xacro:thruster_macro namespace="${namespace}" thruster_id="2">
      <origin xyz="-0.28828 0.18 -0.10969" rpy="0 0 0"/>
    </xacro:thruster_macro>
    
    <!-- Rear right thruster - based on J8 joint -->
    <xacro:thruster_macro namespace="${namespace}" thruster_id="3">
      <origin xyz="-0.28828 0.18 0.10969" rpy="0 0 0"/>
    </xacro:thruster_macro>
    
    <!-- If more thrusters needed, can add based on J5 and J6 joints -->
    <!--
    <xacro:thruster_macro namespace="${namespace}" thruster_id="4">
      <origin xyz="-0.14001 0.33559 -0.125" rpy="0 0 0"/>
    </xacro:thruster_macro>
    
    <xacro:thruster_macro namespace="${namespace}" thruster_id="5">
      <origin xyz="-0.14001 0.33559 0.125" rpy="0 0 0"/>
    </xacro:thruster_macro>
    -->
    
  </xacro:macro>

</robot>

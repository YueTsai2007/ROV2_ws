<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="underwater_robot">

  <!-- Include uuv_simulator common macros -->
  <xacro:include filename="$(find uuv_descriptions)/urdf/common.urdf.xacro"/>
  
  <!-- Include original URDF -->
  <xacro:include filename="$(find underwater_robot)/urdf/underwater_robot.urdf"/>

  <!-- Include thruster configuration -->
  <xacro:include filename="$(find underwater_robot)/urdf/underwater_robot_actuators.xacro"/>

  <!-- Parameters -->
  <xacro:arg name="namespace" default="underwater_robot"/>
  
  <!-- Add uuv_simulator hydrodynamics plugin -->
  <gazebo>
    <plugin name="$(arg namespace)_hydrodynamics" filename="libuuv_underwater_object_ros_plugin.so">
      <fluid_density>1028.0</fluid_density>
      <volume>0.1</volume>
      <bbox_height>0.5</bbox_height>
      <bbox_length>1.0</bbox_length>
      <bbox_width>0.8</bbox_width>
      <hydro_model_type>fossen</hydro_model_type>
      <added_mass>
        <x>50</x> <y>50</y> <z>50</z>
        <roll>10</roll> <pitch>10</pitch> <yaw>10</yaw>
      </added_mass>
      <linear_damping>
        <x>20</x> <y>20</y> <z>20</z>
      </linear_damping>
      <linear_damping_forward_speed>
        <x>0</x> <y>0</y> <z>0</z>
      </linear_damping_forward_speed>
      <angular_damping>
        <x>20</x> <y>20</y> <z>20</z>
      </angular_damping>
      <center_of_buoyancy>
        <x>0</x> <y>0</y> <z>0.1</z>
      </center_of_buoyancy>
      <center_of_buoyancy_damping>
        <x>0</x> <y>0</y> <z>0</z>
      </center_of_buoyancy_damping>
      <neutrally_buoyant>false</neutrally_buoyant>
      <radius>0.5</radius>
    </plugin>
  </gazebo>

  <!-- Invoke thruster macro -->
  <xacro:underwater_robot_actuators namespace="$(arg namespace)"/>

</robot>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="underwater_robot">

  <!-- Include uuv_simulator common macros and thruster snippets -->
  <xacro:include filename="$(find uuv_descriptions)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find uuv_gazebo_ros_plugins)/urdf/thruster_snippets.xacro"/>
  
  <!-- Include original URDF -->
  <xacro:include filename="$(find underwater_robot)/urdf/underwater_robot.urdf"/>

  <!-- Include thruster configuration -->
  <xacro:include filename="$(find underwater_robot)/urdf/underwater_robot_actuators.xacro"/>

  <!-- Parameters -->
  <xacro:arg name="namespace" default="underwater_robot"/>
  
  <!-- Add uuv_simulator hydrodynamics plugin -->
  <gazebo>
    <plugin name="$(arg namespace)_hydrodynamics" filename="libuuv_underwater_object_ros_plugin.so">
      <fluid_density>1028.0</fluid_density>
      <link name="base_link">
        <neutrally_buoyant>false</neutrally_buoyant>
        <volume>0.1</volume>
        <center_of_buoyancy>0 0 0.1</center_of_buoyancy>
        <hydrodynamic_model>
          <type>fossen</type>
          <added_mass>
            50 0 0 0 0 0
            0 50 0 0 0 0
            0 0 50 0 0 0
            0 0 0 10 0 0
            0 0 0 0 10 0
            0 0 0 0 0 10
          </added_mass>
          <linear_damping>-20 -20 -20 -20 -20 -20</linear_damping>
          <linear_damping_forward_speed>0 0 0 0 0 0</linear_damping_forward_speed>
        </hydrodynamic_model>
      </link>
    </plugin>
  </gazebo>

  <!-- Invoke thruster macro (parent_link=base_link matches underwater_robot.urdf) -->
  <xacro:underwater_robot_actuators namespace="$(arg namespace)" parent_link="base_link"/>

</robot>

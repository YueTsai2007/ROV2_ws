<launch>
  <arg name="uuv_name" default="rexrov"/>
  <arg name="arm_name1" default="oberon7"/>
  <arg name="arm_name2" default="oberon7"/>

  <!-- Initialize effort controllers -->
  <include file="$(find oberon7_control)/launch/joint_effort_controllers.launch">
    <arg name="uuv_name" value="$(arg uuv_name)"/>
    <arg name="arm_name" value="$(arg arm_name2)"/>
  </include>



  <group ns="/$(arg uuv_name)/$(arg arm_name1)">
    <!-- Starting the kinematics service node -->
    <node name="kinematics_service" pkg="uuv_manipulators_kinematics" type="kinematics_service.py"
      output="screen"/>

    <!-- Starting direct joint position control node -->
    <node name="joint_position_controller_$(arg arm_name1)" pkg="uuv_manipulators_control" type="joint_position_controller_keyboard.py"
      output="screen">
      <rosparam subst_value="true">
        controller_config:
          azimuth:
            
            axis_gain: 0.01
            topic: /$(arg uuv_name)/$(arg arm_name2)/azimuth/controller/command
            controller:
              p: 1000
              i: 20
              d: 50
          shoulder:
            
            axis_gain: 0.01
            topic: /$(arg uuv_name)/$(arg arm_name2)/shoulder/controller/command
            controller:
              p: 1000
              i: 20
              d: 50
          elbow:
            
            axis_gain: 0.01
            topic: /$(arg uuv_name)/$(arg arm_name2)/elbow/controller/command
            controller:
              p: 1000
              i: 20
              d: 50
          roll:
            
            axis_gain: 0.01
            topic: /$(arg uuv_name)/$(arg arm_name2)/roll/controller/command
            controller:
              p: 300
              i: 10
              d: 20
          pitch:
            
            axis_gain: 0.1
            topic: /$(arg uuv_name)/$(arg arm_name2)/pitch/controller/command
            controller:
              p: 300
              i: 10
              d: 0
          wrist:
            
            axis_gain: 0.01
            topic: /$(arg uuv_name)/$(arg arm_name2)/wrist/controller/command
            controller:
              p: 200
              i: 10
              d: 0
      </rosparam>
    </node>
  </group>
</launch>
